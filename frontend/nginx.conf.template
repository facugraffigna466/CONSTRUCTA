server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Healthcheck simple para Docker/Render.
    location = /health {
        default_type text/plain;
        return 200 'ok';
    }

    # Assets con hash en el nombre (Vite): cache larga.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback: cualquier ruta no encontrada sirve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
