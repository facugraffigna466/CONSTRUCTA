APP_NAME=CONSTRUCTA
APP_DEBUG=true

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-hex-secret

# asyncpg driver required
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/constructa

# ── Phase 2: Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Full public URL where Twilio can reach your webhook.
# For local dev with ngrok: https://abc123.ngrok.io
# Signature validation is skipped when APP_DEBUG=true or TWILIO_AUTH_TOKEN is empty.
PUBLIC_BASE_URL=

# ── Phase 3: AI (not active yet) ──────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
WHISPER_MODEL=base

# ── Emails transaccionales (Brevo) ─────────────────────────────
# Se usan para invitación de miembros, reset de password, verificación de email,
# aviso preventivo de límite de plan, y envío de órdenes de compra a proveedores.
#
# Comportamiento cuando faltan estas variables:
#   - BREVO_API_KEY vacío  → email_service loguea WARNING y devuelve False/None.
#                            El endpoint sigue funcionando (el flujo de invite
#                            devuelve la invite_url en el body para que el admin
#                            la comparta manualmente). Aceptable SOLO en dev.
#   - FRONTEND_URL vacío   → cae al default http://localhost:5173. Los links de
#                            invitación/reset apuntan a localhost — inservibles
#                            para un destinatario externo. En prod HAY QUE
#                            setearlo al dominio real del frontend.
#   - BREVO_SENDER_EMAIL   → sender que aparece en "De:" de cada email. Debe
#                            estar verificado en el dashboard de Brevo. En prod
#                            debe estar en un dominio propio con SPF/DKIM/DMARC
#                            configurados (ver docs/auditoria/01-login-usuarios-planes.md §8.11).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@constructa.local
BREVO_SENDER_NAME=Constructa

# Frontend URL (para armar los links de emails).
# En prod: https://app.tudominio.com
FRONTEND_URL=http://localhost:5173
