APP_NAME=CONSTRUCTA
DEBUG=true

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-hex-secret

# asyncpg driver required
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/constructa

# ── Phase 2: Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Full public URL where Twilio can reach your webhook.
# For local dev with ngrok: https://abc123.ngrok.io
# Signature validation is skipped when DEBUG=true or TWILIO_AUTH_TOKEN is empty.
PUBLIC_BASE_URL=

# ── Phase 3: AI (not active yet) ──────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
WHISPER_MODEL=base
